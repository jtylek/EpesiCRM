# Baseline captures the pre-existing findings (mostly no-PSR-4-autoload/dynamic-dispatch
# noise - see REFERENCE-optimization-opus-AI.md's "PHPStan level 2" implementation log for the
# breakdown); with it included, CI flags only NEW issues (regressions). Regenerate it from
# the phpstan CI job's artifact as we clear real bugs, so it shrinks over time.
includes:
    - phpstan-baseline.neon

parameters:
    # Epesi has no PSR-4 autoload for its own classes (custom module loader), so high levels
    # flood with "unknown class/method". Level 0 catches undefined functions/classes/methods
    # and wrong arg counts; level 1 adds undefined-variable detection, which matters more here
    # than the level number suggests - reading an undefined variable is an E_WARNING under PHP
    # 8.2, and error.php's REPORT_ALL_ERRORS mode blanks a module's whole rendered output on
    # the first warning of a request (see CLAUDE.md). Raised to 1 on 2026-08-31 with the ~220
    # pre-existing findings baselined, so CI fails on *new* ones only. Raised to 2 the same
    # day: it starts checking unknown methods on every typed expression, which the missing
    # autoload makes noisy (mostly Module::__call()'s dynamic dispatch, which PHPStan can't
    # see through, and pre-standardized "@param type description" PHPDoc with no $varname,
    # silently tolerated below level 2 and only parsed - and flagged as malformed - here).
    # ~130 genuinely-typed findings and ~270 malformed-PHPDoc-syntax findings baselined; a
    # few real docblock bugs fixed on the way, see the plan doc.
    level: 2
    phpVersion: 80200
    paths:
        - include
        - modules
        # console/ is first-party too and CI never looked at it - the Symfony commands in
        # there are the one part of this tree with a real autoloader, so they analyse
        # cleanly and are worth keeping that way.
        - console

    # Load minimal stubs for legacy third-party libs so PHPStan can resolve symbols.
    stubFiles:
        - phpstan-stubs/smarty.stub.php
        - phpstan-stubs/quickform.stub.php
        - phpstan-stubs/jsmin.stub.php
        - phpstan-stubs/minify.stub.php

    # let PHPStan discover Epesi + vendor class definitions even without an autoloader.
    # modules/Base/Theme/smarty and libs are vendored PHP (Smarty, Minify, ADOdb, ...) that
    # excludePaths/paths deliberately keep out of error-reporting, but their classes are still
    # referenced from code we do analyze (e.g. simple_login.php, theme_css.php) - without this,
    # PHPStan can't resolve those symbols and reports bogus "class not found" errors.
    scanDirectories:
        - vendor
        - libs
        - modules/Base/Theme/smarty
        - modules/Libs/PHPExcel/vendor
        - modules/CRM/Mail/vendor
        - modules/Libs/TCPDF/vendor
    excludePaths:
        - modules/Libs/RoundCube/RC/program/*
        - modules/Libs/RoundCube/RC/vendor/*
        - modules/Libs/RoundCube/RC/plugins/*
        - modules/Tests/*
        - modules/Base/Theme/smarty/*
        # Separately-licensed, gitignored nested git repos (see CLAUDE.md's Environment quirks).
        # CI checks out neither, so analysing them locally produced a baseline that could never
        # match CI's - the mismatch this file's own note below complained about. Excluding them
        # makes a local run reproduce CI exactly. Each is its own repo and runs its own checks.
        - modules/Premium/*
        - modules/Custom/*
        # nested composer installs (own composer.json under these dirs, populated by
        # composer.json's post-install-cmd) - third-party code, not ours to fix. Kept in
        # scanDirectories above so Epesi code calling into TCPDF/PhpSpreadsheet/Fetch still
        # resolves symbols; found via a full local run with modules/Premium populated and all
        # nested composer deps installed, which surfaced ~280 findings CI's phpstan job (no
        # composer install step, checks out modules/Premium never since it's gitignored) has
        # never actually seen.
        - modules/Libs/PHPExcel/vendor/*
        - modules/CRM/Mail/vendor/*
        - modules/Libs/TCPDF/vendor/*
    # third-party/legacy noise we don't own
    reportUnmatchedIgnoredErrors: false
    # keep parallel workers from timing out on the full codebase (PHPStan default is 600s; a
    # single worker on a large legacy tree can exceed it). Modest process count for stability.
    parallel:
        maximumNumberOfProcesses: 2
        processTimeout: 1200.0
