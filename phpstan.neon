# Baseline captures the ~316 pre-existing findings (mostly no-PSR-4-autoload noise); with it included,
# CI flags only NEW issues (regressions). Regenerate it from the phpstan CI job's artifact as we clear
# real bugs, so it shrinks over time.
includes:
    - phpstan-baseline.neon

parameters:
    # Start low: Epesi has no PSR-4 autoload for its own classes (custom module loader), so higher
    # levels flood with "unknown class/method". Level 0 catches the high-value stuff (undefined
    # functions/classes/methods, wrong arg counts). Raise gradually once a baseline exists.
    level: 0
    phpVersion: 80200
    paths:
        - include
        - modules

    # Load minimal stubs for legacy third-party libs so PHPStan can resolve symbols.
    stubFiles:
        - phpstan-stubs/smarty.stub.php
        - phpstan-stubs/quickform.stub.php
        - phpstan-stubs/jsmin.stub.php
        - phpstan-stubs/minify.stub.php

    # let PHPStan discover Epesi + vendor class definitions even without an autoloader.
    # modules/Base/Theme/smarty and libs are vendored PHP (Smarty, Minify, ADOdb, ...) that
    # excludePaths/paths deliberately keep out of error-reporting, but their classes are still
    # referenced from code we do analyze (e.g. simple_login.php, theme_css.php) - without this,
    # PHPStan can't resolve those symbols and reports bogus "class not found" errors.
    scanDirectories:
        - vendor
        - libs
        - modules/Base/Theme/smarty
        - modules/Libs/PHPExcel/vendor
        - modules/CRM/Mail/vendor
        - modules/Libs/TCPDF/vendor
    excludePaths:
        - modules/Libs/RoundCube/RC/program/*
        - modules/Libs/RoundCube/RC/vendor/*
        - modules/Libs/RoundCube/RC/plugins/*
        - modules/Tests/*
        - modules/Base/Theme/smarty/*
        # nested composer installs (own composer.json under these dirs, populated by
        # composer.json's post-install-cmd) - third-party code, not ours to fix. Kept in
        # scanDirectories above so Epesi code calling into TCPDF/PhpSpreadsheet/Fetch still
        # resolves symbols; found via a full local run with modules/Premium populated and all
        # nested composer deps installed, which surfaced ~280 findings CI's phpstan job (no
        # composer install step, checks out modules/Premium never since it's gitignored) has
        # never actually seen.
        - modules/Libs/PHPExcel/vendor/*
        - modules/CRM/Mail/vendor/*
        - modules/Libs/TCPDF/vendor/*
    # third-party/legacy noise we don't own
    reportUnmatchedIgnoredErrors: false
    # keep parallel workers from timing out on the full codebase (PHPStan default is 600s; a
    # single worker on a large legacy tree can exceed it). Modest process count for stability.
    parallel:
        maximumNumberOfProcesses: 2
        processTimeout: 1200.0
