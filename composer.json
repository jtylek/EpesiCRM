{
    "require": {
        "pimple/pimple": "^3.0",
        "symfony/console": "^6.4",
        "symfony/http-foundation": "^6.4",
        "phpdocumentor/reflection-docblock": "^2.0.4",
        "fakerphp/faker": "^1.23",
        "phpfastcache/phpfastcache": "^9.2",
        "ifsnop/mysqldump-php": "dev-master",
        "enyo/dropzone": "@stable",
        "ezyang/htmlpurifier": "^4.9",
        "openpsa/quickform": "^3.4",
        "adodb/adodb-php": "^5.22",
        "phpseclib/mcrypt_compat": "^2.0",
        "guzzlehttp/psr7": "^2.7",
        "psy/psysh": "@stable"
    },
    "scripts": {
        "post-install-cmd": [
            "@composer -d=\"modules/CRM/Mail\" install",
            "@composer -d=\"modules/Libs/PHPExcel\" install",
            "@composer -d=\"modules/Libs/TCPDF\" install"
        ]
    },
    "autoload": {
        "psr-4": {
            "Epesi\\Console\\": "console/",
            "Epesi\\Module\\": "modules/"
        },
        "psr-0": {
            "": "modules/"
        }
    }
}
