*.log
.vscode/
.env
.claude/
.history/
.playwright-mcp/

# Each module here is a separately purchased/installed premium add-on,
# managed by its own git repository - not part of this one.
modules/Premium/

# Same idea as Premium/ above, but per-installation: modules/Custom/ holds
# site-specific custom modules, each expected to be its own nested git repo
# (not part of this one) once it exists - except Tutorial, the one example
# module that ships with this repo (see AI-shared/Dev-Tutorial.md) and is
# meant to stay tracked here.
modules/Custom/*
!modules/Custom/Tutorial

# Build output of console/Develop/CreateDistCommand.php (dev:dist:create)
/epesi-*.zip

# Epesi runtime data directory in full - config, cache, uploads, stored
# files, logs, per-instance tokens, everything under it is either
# regenerated or user/instance content, never source. Ignore everything
# except the one placeholder that keeps the directory present in a fresh
# checkout (git doesn't track empty directories, and the app expects data/
# to already exist on a new install).
data/*
!data/index.html

# Smarty compile/cache/config output (see TEMP_DIR, include/config.php) —
# lives outside data/ entirely so it's never swept into data backups
/temp/

# Per-installation custom translation overrides used to live under modules/
# next to each module's shipped lang/<code>.php defaults; moved to
# data/Base_Lang/custom/ (already covered by the data/* rule above) so
# instance data never touches the modules/ tree at all - see
# Base_LangCommon::append_custom().

# Scratch planning notes for unrelated side projects (e.g. parts-kits/) that
# don't belong in the EPESI codebase's history.
/parts-kits/
