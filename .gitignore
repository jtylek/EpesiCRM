*.log
.vscode/
.env
.claude/
.history/
.playwright-mcp/

# Each module here is a separately purchased/installed premium add-on,
# managed by its own git repository - not part of this one.
modules/Premium/

# Build output of console/Develop/CreateDistCommand.php (dev:dist:create)
/epesi-*.zip

# Epesi runtime-generated (regenerated by the app — must not be tracked)
data/cache/
data/Base_Theme/templates/
data/tmp/
data/config.php

# Smarty compile/cache/config output (see TEMP_DIR, include/config.php) —
# lives outside data/ entirely so it's never swept into data backups
/temp/

# Secrets / per-instance tokens
data/cron_token.php

# Per-installation custom translation overrides - live under modules/ next to
# each module's shipped lang/<code>.php defaults, but are local instance data,
# not source (see Base_LangCommon::append_custom()).
modules/*/lang/*_custom.php
modules/*/*/lang/*_custom.php
modules/*/*/*/lang/*_custom.php
modules/*/*/*/*/lang/*_custom.php

# Instance/runtime data (user content, uploads, stored files, logs — never ship these)
data/Base_Error/*.txt
data/Utils_FileStorage/
data/Utils_FileUpload/
data/Utils/
data/CRM_Mail/d/
data/CRM_Mail/attachments/
data/CRM_Tasks/d/
data/CRM_Roundcube/log/
data/CRM_Roundcube/tmp/
data/CRM_Roundcube/company_logo.png
data/Libs_TCPDF/*.pdf
