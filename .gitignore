*.log
.DS_Store
.env
.env.backup
.env.production
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
# Separate private notes repo, nested here for a core developer's checkout only.
/AI-private
/auth.json
# Written into each release zip by `epesi:package` (FrameworkCaches::guard()).
/bootstrap/release-id
/database/*.sqlite*
# Installed modules arrive as zips at runtime; only first-party ones under the
# Epesi vendor ship with the core.
/modules/*
!/modules/Epesi
# Premium and Custom modules live in separate nested git repositories and are
# never tracked by this repository.
/modules/Premium/
/modules/Custom/
# Never a place for a Premium module (it belongs in /modules/Premium/); ignored as a
# safety net so a misplaced one can't be committed here by accident.
/modules/Epesi/Premium/
/node_modules
/public/build
/public/hot
# Roundcube, downloaded by `php artisan roundcube:install`, and its web entry (old name: roundcube).
/public/roundcube
/public/epesi-webmail
/public/storage
/storage/*.key
/storage/pail
/storage/roundcube
/storage/roundcube.*
/storage/framework/roundcube*
# Scratch output of development tools, e.g. screenshots (temp/screenshots).
/temp
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# VS Code local-history extension (can contain old .env snapshots with secrets)
/.history

# OpenSSL random-state file, left behind by openssl on Windows
/.rnd

# Agent handoffs and mailbox (AI-shared/development/agent-coordination.md)
/.wip

# Claude Code's own per-session git worktrees (EnterWorktree), machine-local
/.claude/worktrees/

/Workshop1982_Data/

# Claude Code per-machine settings
/.claude/settings.local.json
